# KALPA: The Journey of Creation - Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control!

# --- Feedback Submission ---
# Google Apps Script Web App URL (deploy your Sheet appscript as "Anyone" can access)
# Template: https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
VITE_FEEDBACK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Adapter: googlesheet | formspree | netlify
VITE_FEEDBACK_ADAPTER=googlesheet

# Formspree endpoint (if using formspree adapter)
VITE_FORMSPREE_URL=https://formspree.io/f/YOUR_FORM_ID

# --- Admin Panel ---
VITE_ADMIN_PASSWORD=kalpa2024

# Optional: fetch feedback JSON for admin dashboard
VITE_ADMIN_FEEDBACK_API=

# --- AI Voice Guide (Ask Naad) ---
VITE_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
VITE_LLM_API_KEY=your_openai_key_here
VITE_LLM_MODEL=gpt-4o-mini

# --- ElevenLabs TTS (optional voice swap) ---
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=

# --- Multiplayer WebSocket (Phase 3) ---
VITE_WS_SERVER=ws://localhost:8080
